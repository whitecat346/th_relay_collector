# AI 辅助判定配置（可选）
#
# 用法：把本文件复制成同目录的 ai.yml（ai.yml 已被 .gitignore 排除，不会进仓库），
# 填好自己的 key，然后跑 `jieli.exe --link <入口链接> --ai`。
# 不建 ai.yml 或不加 --ai，则完全不走 AI，其余功能不受影响。
#
# 设计约束（实现见 src/JieLi.Tui/Chain/AiAssist.cs）：
#   - 默认关闭，必须 --ai 显式开启；
#   - 每次调用前逐次确认（--ai-yes 可免确认）；
#   - 每次运行有调用预算（--ai-budget，默认 20），超出即停；
#   - 每次调用的请求/回复都追加写入 work/ai-log.jsonl；
#   - 只发「正文片段 + 候选 uid/昵称 + 期望棒号时段」，绝不发整页 HTML 或 cookie。

# OpenAI 兼容的 base_url（不要带 /chat/completions，程序自己拼）
base_url: https://api.deepseek.com/v1
api_key: 在这里填你的 key
model: deepseek-chat

# 可选：单次请求超时秒数（默认 60）
# timeout_seconds: 60
