<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>JieLi.Tui</RootNamespace>
    <AssemblyName>jieli</AssemblyName>
    <!-- 中文按 UTF-8 读取源文件，避免 Roslyn 按 ANSI 误解码中文字面量 -->
    <CodePage>65001</CodePage>
    <Utf8Output>true</Utf8Output>
    <InvariantGlobalization>false</InvariantGlobalization>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!-- 渲染基座：样式/颜色能力检测/表格排版（见 docs/UI-UX-PLAN.md） -->
    <PackageReference Include="Spectre.Console" Version="0.57.2" />
    <!-- 终端显示宽度（CJK/emoji 字素簇），替代手写宽度区间表 -->
    <PackageReference Include="Wcwidth" Version="4.0.1" />
  </ItemGroup>

</Project>
